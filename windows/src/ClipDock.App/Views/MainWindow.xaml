<Window
    x:Class="ClipDock.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClipDock.App.ViewModels"
    Title="ClipDock">
    <Grid Padding="16" RowDefinitions="Auto,*" ColumnDefinitions="220,360,*" ColumnSpacing="12" RowSpacing="12">
        <TextBox
            Grid.ColumnSpan="3"
            PlaceholderText="Search clipboard"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <NavigationView Grid.Row="1" PaneDisplayMode="LeftMinimal" IsSettingsVisible="False" IsBackButtonVisible="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All" Icon="AllApps" />
                <NavigationViewItem Content="Pinned" Icon="Pin" />
                <NavigationViewItem Content="Text" Icon="Document" />
                <NavigationViewItem Content="Images" Icon="Pictures" />
                <NavigationViewItem Content="Files" Icon="Folder" />
            </NavigationView.MenuItems>
        </NavigationView>

        <ListView
            Grid.Row="1"
            Grid.Column="1"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                    <Grid Padding="10" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="*,Auto" RowSpacing="12">
            <TextBox
                Text="{x:Bind ViewModel.SelectedPreview, Mode=OneWay}"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                IsReadOnly="True" />
            <Button Grid.Row="1" Content="Copy" Command="{x:Bind ViewModel.CopySelectedCommand}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
